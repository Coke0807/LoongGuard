# Python 字节码
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 虚拟环境
.venv/
venv/
.venv.bak/
venv.bak/

# 分发 & 构建产物
*.egg-info/
*.egg
dist/
build/
eggs/
sdist/
develop-eggs/
*.whl
pip-wheel-metadata/
.installed.cfg

# 类型检查 & 静态分析缓存
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# 环境变量（含真实密钥，绝不可入库）
.env
.env.local
.env.*.local

# SQLite 数据库文件
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# 操作系统临时文件
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
~$*

.DS_Store
.AppleDouble
.LSOverride
._*

*~
.fuse_hidden*
.directory

# IDE & 编辑器配置
.vscode/
.idea/
*.iml
*.iws
*.ipr
.sublime-project
.sublime-workspace
*.swp
*.swo
Session.vim
.netrwhist
\#*\#
.\#*
.ipynb_checkpoints/
.trae/

# 测试 & 覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.tox/
.nox/
.hypothesis/
.cache

# 日志文件
logs/
log/
*.log
*.log.*

# 杂项
node_modules/
.mcp.json

# 语音模块模型产物
models/wakeword/*.onnx
models/wakeword/*.tflite
models/pocketsphinx/zh-cn/
models/pocketsphinx/*.dict
