# ============================================================
# LoongGuard backend/.gitignore — 后端专属规则
# 通用规则（__pycache__、.env、venv、IDE、OS 等）已移至根目录 .gitignore
# ============================================================
#
# 过滤策略:
#   忽略 - 运行时产物、编译产物、密钥、压缩包、临时目录、大体积二进制
#   提交 - 源代码、配置、测试视频素材、项目文档
#
# 大文件阈值: 50MB (超过此大小的单文件建议评估后决定是否入库)
# 视频素材路径:
#   tests/mock_classroom.mp4         - 冒烟测试合成视频（6MB，CI 必跑）
#   tests/fixtures/*.mp4             - 真实幼儿园素材（效果回归测试）
#   datasets/raw/                    - 训练数据集原始视频
#   video/                           - 临时素材工作目录（不入库，迁移完成后删除）
# 模型文件路径: models/ 下的 .onnx / .pt / 视频等大文件明确排除，不入库，
#   由用户通过独立渠道手动分发（脚本 sync.py 通过 force_include 同步到龙芯）
# ============================================================


# ──────────────────────────────────────────────
# 运行时产物 (可重新生成, 非开发必需)
# ──────────────────────────────────────────────


# 运行时日志 (server 进程 stdout/stderr 重定向)
server_*.log

# 运行时数据目录（可重新生成，全部忽略；代码通过 mkdir 自动创建）
data/
# 持久化数据集资产（提交；raw/ 内大视频按独立渠道分发，仅保留占位）
datasets/
!datasets/raw/.gitkeep
!datasets/processed/
!datasets/processed/data.yaml

# 临时素材工作目录（迁移至 tests/fixtures/ 后应删除）
video/


# ──────────────────────────────────────────────
# 密钥 & 证书 (敏感文件)
# ──────────────────────────────────────────────
*.pem
*.key
*.secret
*.p12
*.pfx
*.jks

# SM4 加密临时文件
*.sm4
*.enc
*.dec
config/.sm4_key


# ──────────────────────────────────────────────
# C/C++ 编译产物 (LoongArch 交叉编译或本地构建)
# ──────────────────────────────────────────────
*.o
*.obj
*.lo
*.slo
*.d
*.dSYM/
*.su
*.idb
*.pdb
*.gcno
*.gcda

# 性能分析
*.prof
*.prof.gz
*.profile


# ──────────────────────────────────────────────
# 构建 & 部署产物
# ──────────────────────────────────────────────
out/
target/
output/
release/

# Docker
docker-compose.override.yml
.docker/

# 压缩包
*.tar.gz
*.tar.bz2
*.tgz
*.zip
*.7z
*.rar


# ──────────────────────────────────────────────
# 临时 & 缓存目录
# ──────────────────────────────────────────────
tmp/
temp/
.tmp/
.temp/
.cached/

# 备份文件
*.bak
*.orig
*.backup
*.old


# pip 日志
pip-log.txt
pip-delete-this-directory.txt

