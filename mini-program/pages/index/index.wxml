<!-- 我的幼儿页面：我的逻辑 + 队友 UI -->
<view class="page-container">
  <view class="page-content">
    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-state">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{studentList.length === 0}}" class="empty-state">
      <view class="empty-icon-circle">
        <view class="empty-icon">👶</view>
      </view>
      <view class="empty-title">暂无绑定的幼儿信息</view>
      <view class="empty-desc">请绑定家长手机号以查看您的孩子信息</view>
      <button class="btn-bind" bindtap="goBindPhone">绑定手机号</button>
    </view>

    <!-- 幼儿卡片列表 -->
    <view
      wx:for="{{studentList}}"
      wx:key="student_id"
      class="stu-card"
    >
      <view class="stu-header">
        <view class="stu-avatar">
          <view class="avatar-emoji">👶</view>
        </view>
        <view class="stu-name-wrap">
          <view class="stu-name">{{item.name}}</view>
          <view class="stu-tag">已绑定</view>
        </view>
      </view>

      <view class="stu-info-list">
        <view class="stu-info-item">
          <view class="info-icon-box">🏫</view>
          <text class="info-label">班级：</text>
          <text class="info-value">{{item.class}}</text>
        </view>
        <view class="stu-info-item" wx:if="{{item.grade}}">
          <view class="info-icon-box">📅</view>
          <text class="info-label">年级：</text>
          <text class="info-value">{{item.grade}}</text>
        </view>
        <view class="stu-info-item" wx:if="{{item.phone}}">
          <view class="info-icon-box">📞</view>
          <text class="info-label">家长：</text>
          <text class="info-value">{{item.phone}}</text>
        </view>
        <view class="stu-info-item">
          <view class="info-icon-box">📹</view>
          <text class="info-label">远程监控：</text>
          <view class="perm-status perm-open" wx:if="{{item.switch === 1}}">
            <text class="perm-check">✓</text>
            <text class="perm-text">已开通</text>
          </view>
          <view class="perm-status perm-closed" wx:else>
            <text class="perm-lock">🔒</text>
            <text class="perm-text">未开通</text>
          </view>
        </view>
      </view>

      <button class="btn-unbind" data-id="{{item.student_id}}" data-name="{{item.name}}" bindtap="unbindStudent">
        解除绑定
      </button>
    </view>
  </view>
</view>
