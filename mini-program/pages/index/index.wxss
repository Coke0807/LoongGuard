/* 我的幼儿页面样式 */
.page-container {
  min-height: 100vh;
  background: #F5F8FC;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 24rpx 32rpx 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #dbeafe;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon-circle {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}

.btn-bind {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
  text-align: center;
  padding: 0;
}

.btn-bind::after {
  border: none;
}

.btn-bind:active {
  opacity: 0.85;
  background: #3d7bc2;
}

/* 幼儿卡片 */
.stu-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.stu-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.stu-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #eff6ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 52rpx;
}

.stu-name-wrap {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stu-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.stu-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #4A90D9;
  align-self: flex-start;
}

.stu-info-list {
  margin-bottom: 28rpx;
}

.stu-info-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.stu-info-item:last-child {
  margin-bottom: 0;
}

.info-icon-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info-label {
  font-size: 26rpx;
  color: #9ca3af;
}

.info-value {
  font-size: 26rpx;
  color: #4b5563;
}

/* 监控权限状态 */
.perm-status {
  display: flex;
  align-items: center;
}

.perm-open {
  color: #22c55e;
}

.perm-check {
  font-size: 24rpx;
  margin-right: 4rpx;
  font-weight: bold;
}

.perm-open .perm-text {
  font-size: 26rpx;
  color: #22c55e;
  font-weight: 500;
}

.perm-closed {
  color: #f59e0b;
}

.perm-lock {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.perm-closed .perm-text {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 500;
}

/* 解除绑定按钮 */
.btn-unbind {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #E74C3C;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: 2rpx solid #fecaca;
  text-align: center;
  padding: 0;
}

.btn-unbind::after {
  border: none;
}

.btn-unbind:active {
  background: #fef2f2;
}
