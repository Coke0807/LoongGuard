.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F4FD 0%, #D4ECFA 100%);
}

.page-content {
  padding: 0 24rpx 24rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.header-section {
  padding: 16rpx 8rpx 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon-circle {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.empty-icon-placeholder {
  width: 52rpx;
  height: 44rpx;
  border: 3rpx solid #94a3b8;
  border-radius: 6rpx;
  position: relative;
  opacity: 0.5;
}

.empty-icon-placeholder::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  margin-left: -7rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #94a3b8;
}

.empty-icon-placeholder::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 6rpx;
  width: 8rpx;
  height: 8rpx;
  background: #94a3b8;
  border-radius: 2rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.growth-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.growth-card {
  width: calc(50% - 12rpx);
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}

.growth-card-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.growth-image-wrapper {
  width: 100%;
  height: 320rpx;
  position: relative;
  overflow: hidden;
}

.growth-image {
  width: 100%;
  height: 100%;
  display: block;
}

.growth-info {
  padding: 20rpx 16rpx;
}

.growth-date {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.growth-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.list-end {
  padding: 40rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
