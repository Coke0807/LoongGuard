<view class="page-container">
  <view class="page-content">
    <view class="header-section">
      <view class="page-title">成长记录</view>
      <view class="page-subtitle">留住宝贝在园的每一个精彩瞬间</view>
    </view>

    <view wx:if="{{growthList.length === 0}}" class="empty-state">
      <view class="empty-icon-circle">
        <view class="empty-icon-placeholder"></view>
      </view>
      <view class="empty-title">暂无成长记录</view>
      <view class="empty-desc">老师上传记录后将在此显示</view>
    </view>

    <view wx:else class="growth-grid">
      <view
        wx:for="{{growthList}}"
        wx:key="id"
        class="growth-card"
        data-image="{{item.image}}"
        bindtap="onPreviewImage"
        hover-class="growth-card-hover"
      >
        <view class="growth-image-wrapper">
          <image
            class="growth-image"
            src="{{item.image}}"
            mode="aspectFill"
            lazy-load="true"
          />
        </view>
        <view class="growth-info">
          <view class="growth-date">{{item.date}}</view>
          <view class="growth-title">{{item.title}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{growthList.length > 0}}" class="list-end">没有更多记录了</view>
  </view>
</view>
