/* 登录绑定页面样式：队友 UI + 我的头像样式 */

.login-page {
  min-height: 100vh;
  background: #F5F8FC;
  display: flex;
  flex-direction: column;
  padding: 0 64rpx;
  box-sizing: border-box;
}

/* 顶部留白 */
.top-space {
  height: 80rpx;
  flex-shrink: 0;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-box {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

/* CSS 绘制盾牌图标 */
.logo-shield {
  width: 64rpx;
  height: 76rpx;
  background: #4A90D9;
  border-radius: 50% 50% 50% 50% / 30% 30% 60% 60%;
  position: relative;
}
.logo-shield::before {
  content: '';
  position: absolute;
  top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 22rpx;
  border: 4rpx solid #fff;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
}
.logo-shield::after {
  content: '';
  position: absolute;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 8rpx;
  border: 4rpx solid #fff;
  border-top: none;
  border-radius: 0 0 50% 50%;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
  text-align: center;
}

/* 表单区域 */
.form-section {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像选择（保留我的样式） */
.avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 128rpx;
}
.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 22rpx;
  color: #c0c4cc;
  text-align: center;
  line-height: 1.3;
}

/* 输入框组 */
.input-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e5e7eb;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.2s;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  color: #9ca3af;
  width: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: #374151;
}

.placeholder {
  color: #9ca3af;
}

/* 按钮区域 */
.btn-section {
  margin-top: 48rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  opacity: 0.85;
  background: #3d7bc2;
}

.login-btn-loading {
  opacity: 0.7;
}

.btn-text {
  font-size: 28rpx;
}

/* 协议勾选 */
.agreement-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement-checkbox {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 6rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.agreement-checkbox.checked {
  background: #4A90D9;
  border-color: #4A90D9;
}

.check-mark {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.agreement-text {
  font-size: 22rpx;
  color: #6b7280;
}

.link {
  color: #4A90D9;
}

/* 底部区域 */
.footer-section {
  margin-top: auto;
  padding-bottom: 48rpx;
  padding-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-text {
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
}

.footer-bar {
  margin-top: 24rpx;
  width: 200rpx;
  height: 4rpx;
  background: #d1d5db;
  border-radius: 8rpx;
}
