<!-- 通知公告页面：静态演示数据 -->
<view class="page-container">
  <!-- 筛选标签栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="switchFilter">
      全部
    </view>
    <view class="filter-item {{filter === 'unread' ? 'filter-active' : ''}}" data-filter="unread" bindtap="switchFilter">
      未读
      <view wx:if="{{unreadCount > 0}}" class="filter-badge">{{unreadCount}}</view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="page-content">
    <!-- 空状态 -->
    <view wx:if="{{displayList.length === 0}}" class="empty-state">
      <view class="empty-icon-circle">
        <view class="empty-icon">📭</view>
      </view>
      <view class="empty-title">暂无通知公告</view>
      <view class="empty-desc">{{filter === 'unread' ? '所有通知均已阅读' : '暂无公告'}}</view>
    </view>

    <!-- 公告列表 -->
    <view
      wx:for="{{displayList}}"
      wx:key="id"
      class="notice-card {{item.read ? '' : 'notice-unread'}}"
      data-id="{{item.id}}"
      bindtap="tapNotice"
    >
      <view class="notice-header">
        <view wx:if="{{!item.read}}" class="unread-dot"></view>
        <view class="notice-title">{{item.title}}</view>
        <view class="notice-tag {{item.tagClass}}">{{item.typeText}}</view>
      </view>

      <view class="notice-content">{{item.summary}}</view>

      <view class="notice-time">
        <text>🕐</text>
        <text style="margin-left:8rpx;">{{item.date}}</text>
        <view wx:if="{{item.read}}" class="read-tag">已读</view>
      </view>
    </view>

    <view wx:if="{{displayList.length > 0}}" class="list-end">— 没有更多了 —</view>
  </view>
</view>
