# ============================================================
# LoongGuard 根目录 .gitignore — 覆盖全项目通用规则
# 环境: Windows 11 主机 → 私密远程仓库 → LoongArch 远程主机
# ============================================================


# ──────────────────────────────────────────────
# Python 字节码 & 虚拟环境
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

.venv/
venv/
.venv.bak/
venv.bak/


# ──────────────────────────────────────────────
# 分发 & 构建产物
# ──────────────────────────────────────────────
*.egg-info/
*.egg
dist/
build/
eggs/
sdist/
develop-eggs/
*.whl
pip-wheel-metadata/
.installed.cfg


# ──────────────────────────────────────────────
# 类型检查 & 静态分析缓存
# ──────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/


# ──────────────────────────────────────────────
# 环境变量（含真实密钥，绝不可入库）
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local


# ──────────────────────────────────────────────
# 操作系统临时文件
# ──────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
~$*

.DS_Store
.AppleDouble
.LSOverride
._*

*~
.fuse_hidden*
.directory


# ──────────────────────────────────────────────
# IDE & 编辑器配置
# ──────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
*.swp
*.swo
Session.vim
.netrwhist
\#*\#
.\#*
.ipynb_checkpoints/
.trae/


# ──────────────────────────────────────────────
# 测试 & 覆盖率
# ──────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.tox/
.nox/
.hypothesis/
.cache


# ──────────────────────────────────────────────
# 日志文件（通配，覆盖 backend/ 和 frontend/）
# ──────────────────────────────────────────────
logs/
log/
*.log
*.log.*


# ──────────────────────────────────────────────
# 杂项
# ──────────────────────────────────────────────
node_modules/
.mcp.json