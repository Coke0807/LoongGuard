# ============================================================
# LoongGuard 根目录 .env.example — 前后端端口统一编排
# 复制为 .env 并按需修改；变量统一前缀 LG_
# ============================================================

# ── 前后端统一端口约定（推荐 8080）────────────────────────
# 后端（backend/）在此端口同时提供 REST API、/stream(MJPEG)、/ws/alerts(WebSocket)，
# 前端（frontend/）作为同一端口的客户端连接。
# 两端默认端口必须一致，避免"各自为政"导致连不上流/告警。

# 后端 API 监听端口（默认值来自 backend/config/default.json 的 api.port）
LG_API_PORT=8080

# 前端连接后端流/告警地址（默认指向 LG_API_PORT 对应端口，需与后端一致）
LG_STREAM_URL=http://127.0.0.1:8080/stream
LG_WS_URL=ws://127.0.0.1:8080/ws/alerts

# ── 完整后端配置项见 backend/.env.example ─────────────────