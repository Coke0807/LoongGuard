# ============================================================
# LoongGuard 统一环境变量模板（项目根目录，前后端共享）
# 使用方法：复制本文件为 .env 并填入实际值
# 变量统一前缀 LG_；后端(pipeline)与前端(main.py)启动时自动加载根 .env
#
# 值书写规则（三处加载器统一语义）：
#   - 整行以 # 开头 = 注释行
#   - 值用引号包裹时内部 # 原样保留：LG_AUTH_PASS="p@ss#word"
#   - 未加引号时，仅"空白+#"视为行内注释；紧跟值的 #（abc#def）属于值本身
#   - ⚠️ systemd EnvironmentFile 不剥离行内注释，生产 .env 请勿写行内注释
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────
LG_ENV=development              # development | testing | production

# ── 前后端统一端口约定（推荐 8080）────────────────────────
# 后端在此端口同时提供 REST API、/stream(MJPEG)、/ws/alerts(WebSocket)，
# 前端作为同一端口的客户端连接。两端默认端口必须一致。
LG_API_PORT=8080
# 前端连接后端流/告警地址（需与 LG_API_PORT 对应）
LG_STREAM_URL=http://127.0.0.1:8080/stream
LG_WS_URL=ws://127.0.0.1:8080/ws/alerts

# ── SSH 远程连接（龙芯开发板）────────────────────────────
LG_SSH_HOST=                    # 龙芯设备 IP 地址（必填）
LG_SSH_PORT=22                  # SSH 端口
LG_SSH_USER=                    # SSH 用户名（必填）
LG_SSH_PASS=                    # SSH 密码
LG_SSH_KEY=                     # SSH 私钥路径（可选，优先于密码）

# ── 摄像头配置 ──────────────────────────────────────────
# 设备路径：Linux 下为 /dev/videoN，测试环境可指定视频文件
LG_CAMERA_DEVICE=0
LG_CAMERA_WIDTH=640
LG_CAMERA_HEIGHT=480
LG_CAMERA_FPS=30

# ── 模型权重路径 ──────────────────────────────────────────
# 方式B：环境变量覆盖 default.json，优先级最高，切换模型免改代码
# 路径相对 backend/ 目录解析，模型文件位于 backend/models/ 下
LG_DETECTION_MODEL_PATH=models/best.onnx                 # YOLO26-Nano 危险物品检测
LG_POSE_MODEL_PATH=models/movenet_lightning_int8.onnx    # MoveNet 俯卧姿态检测
LG_FACE_MODEL_PATH=models/buffalo_l/det_10g.onnx         # 人脸检测（睡姿监测）

# ── 检测配置 ─────────────────────────────────────────────
LG_DETECTION_CONF_THRESHOLD=0.80
LG_DETECTION_QUANTIZED=false

# ── 人脸检测（睡姿监测，默认关闭）────────────────────────
# 启用后使用 buffalo_l/det_10g.onnx 模型检测人脸
LG_FACE_ENABLED=false           # true=启用，false=关闭
LG_FACE_BACKEND=onnx            # 检测后端：onnx / dummy
LG_FACE_CONF_THRESHOLD=0.5      # 人脸置信度阈值（0.0~1.0）

# ── 姿态估计 (MoveNet) ───────────────────────────────────
LG_POSE_INFERENCE_INTERVAL=3    # 每 N 帧执行一次俯卧检测
LG_POSE_PRONE_ANGLE_THRESHOLD=30.0
LG_POSE_PRONE_FRAME_THRESHOLD=30

# ── 推理性能调优 (LoongArch LG200 8 核自适应) ──────────
LG_ONNX_INTRA_OP_THREADS=

# ─ GPIO 声光告警配置（alarm 配置节；旧名 LG_GPIO_* 为无效变量，已更名）──
LG_ALARM_BUZZER_PIN=18         # 蜂鸣器 GPIO 引脚号
LG_ALARM_LED_PIN=23            # 告警 LED 引脚号
LG_ALARM_STATUS_LED_PIN=24     # 状态 LED 引脚号

# ── SM4 加密 ─────────────────────────────────────────────
# 必须填入 32 位 hex 字符串（16 字节），否则启动失败
# 生成方式: openssl rand -hex 16
LG_SM4_KEY=                     # TODO: 填入实际的 SM4 密钥

# ── 日志 ─────────────────────────────────────────────────
LG_LOG_LEVEL=INFO
LG_LOG_FORMAT=text

# ── API 服务 ────────────────────────────────────────────
LG_API_HOST=0.0.0.0             # 0.0.0.0 才能远程访问

# ── API 访问控制（生产环境必须启用）──────────────────────
LG_API_AUTH_ENABLED=false       # 生产置为 true
LG_AUTH_USER=                   # Basic Auth 用户名
LG_AUTH_PASS=                   # Basic Auth 密码（生产用强密码）

# ── 外部告警通知（可选，无人值守防漏报）──────────────────
LG_NOTIFY_ENABLED=false         # 置为 true 启用外部通知
LG_NOTIFY_WEBHOOK_URL=          # POST JSON 回调地址（微信小程序/短信/电话网关）
LG_NOTIFY_MIN_SEVERITY=high     # 触发通知的最低等级（low/medium/high/critical）
LG_NOTIFY_RETRIES=3             # 失败重试次数
LG_NOTIFY_RETRY_BACKOFF_SEC=2.0 # 重试退避基数（秒）

# ── 数据库备份（可选）────────────────────────────────────
LG_DATABASE_BACKUP_DIR=data/db/backup        # 备份目录
LG_DATABASE_BACKUP_INTERVAL_HOURS=24       # 备份间隔（小时）
LG_DATABASE_BACKUP_RETENTION_DAYS=7        # 备份保留天数

# ── 调试选项 ─────────────────────────────────────────────
# 启用后显示 OpenCV 调试窗口（仅开发环境使用）
LG_DEBUG_WINDOW=
# ── 家长端（微信小程序 + 管理后台，api/parent_routes.py）──
# 数据库文件（管理员/班级/幼儿/家长/公告/成长记录）
LG_PARENT_DB_PATH=./data/class_monitor.db
# 微信小程序凭据（须与 project.config.json 的 appid 配对）
LG_PARENT_WX_APPID=your_wx_appid
LG_PARENT_WX_APPSECRET=your_wx_appsecret
# JWT 密钥（生成方式: openssl rand -hex 32）
LG_PARENT_ADMIN_JWT_SECRET=change-me-admin-jwt-secret
LG_PARENT_WX_JWT_SECRET=change-me-wx-jwt-secret
# 允许家长远程观看时段（JSON 二维数组）
LG_PARENT_ALLOW_TIME_PERIODS=[["08:00","12:00"],["14:00","17:30"]]
# 幼儿入班默认年级
LG_PARENT_ENROLL_YEAR=2026
# Excel 导入模板目录（默认 backend/static/template）
LG_PARENT_TEMPLATE_DIR=
# 家长端上传文件根目录（默认 backend/data/parent/uploads）
LG_PARENT_UPLOAD_DIR=

# ── 语音模块（voice/，openWakeWord 唤醒 + PocketSphinx 指令）──
LG_VOICE_ENABLED=true            # false=整体停用语音模块（缺模型/依赖时也会自动降级）
LG_VOICE_WAKE_THRESHOLD=0.5      # 唤醒判定阈值（0~1，越高越保守）
LG_VOICE_WAKE_COOLDOWN_SEC=3.0   # 唤醒冷却秒数（防连续重复触发）
LG_VOICE_WAKE_TIMEOUT_SEC=8.0    # 唤醒后等待指令超时，超时回待机
LG_VOICE_COMMAND_DURATION_SEC=3.0 # 唤醒后单次指令录音时长（秒）
LG_VOICE_TTS_BACKEND=auto        # auto/pyttsx3/espeak/dummy
# 模型路径（默认值如下，仅自定义放置位置时需填写）
# LG_VOICE_WAKE_MODEL_PATH=models/wakeword/my_wakeword.onnx
# LG_VOICE_SPHINX_MODEL_DIR=models/pocketsphinx/zh-cn
# LG_VOICE_SPHINX_DICT_PATH=models/pocketsphinx/cmudict-cn.dict
# LG_VOICE_SPHINX_JSGF_PATH=models/pocketsphinx/commands.jsgf

# ── 物体持续出现过滤（persistence，防单帧误检瞬时误报）────
LG_PERSISTENCE_PERSISTENCE_SEC=1.0    # 物体需持续出现的最小秒数
LG_PERSISTENCE_MAX_MISSED_SEC=0.5     # 消失超过此秒数则移除跟踪
LG_PERSISTENCE_POSITION_GRID_SIZE=50  # 位置网格量化粒度（像素）

# ── 告警去重（dedup）────────────────────────────────────
LG_DEDUP_ENABLED=true                 # 启用去重
LG_DEDUP_TIME_WINDOW_SEC=30.0         # 同一物体去重时间窗（秒）
LG_DEDUP_POSITION_GRID_SIZE=50        # 位置网格（像素）
LG_DEDUP_MAX_TRACKED_OBJECTS=1000     # 跟踪对象上限（防内存泄漏）

# ── 跨平台媒体（media）──────────────────────────────────
LG_MEDIA_AUDIO_BACKEND=command        # command（系统命令）/ dummy
LG_MEDIA_STREAM_PUBLISHER=mjpeg       # mjpeg（开发/局域网）/ webrtc（板端预留）
LG_MEDIA_WEBRTC_SIGNAL_PORT=8888      # WebRTC 信令端口（publisher=webrtc 时生效）

# ── HLS 远程直播（家长端小程序观看，ffmpeg 切片）────────
LG_MEDIA_HLS_ENABLED=true             # ffmpeg 缺失/密钥缺失时自动停用
LG_MEDIA_HLS_INPUT=loopback           # loopback=回环消费本服务 MJPEG；板端可填 /dev/video0
# LG_MEDIA_HLS_INPUT_FORMAT=          # 强制输入 demuxer（如 mpjpeg），留空自动探测
LG_MEDIA_HLS_VIDEO_WIDTH=640          # 输出宽度上限（等比缩放）
LG_MEDIA_HLS_FPS=15                   # 输出帧率
LG_MEDIA_HLS_VIDEO_BITRATE=800k       # 输出码率
LG_MEDIA_HLS_SEGMENT_DURATION_SEC=2.0 # 单分片时长（秒），越小延迟越低
LG_MEDIA_HLS_LIST_SIZE=6              # 播列窗口分片数（回看 ≈ list_size × 分片时长）
LG_MEDIA_HLS_IDLE_TIMEOUT_SEC=180     # 无观看者自动停编码的秒数（省算力）
LG_MEDIA_HLS_TOKEN_TTL_SEC=21600      # 观看 token 有效期（秒）
# LG_HLS_STREAM_SECRET=               # token 签名密钥；留空回退 LG_SM4_KEY（openssl rand -hex 32）

# ── 告警库补充（database，前缀 LG_DATABASE_）──────────────
# LG_DATABASE_DB_PATH=                # 默认 backend/data/db/loongguard.db
LG_DATABASE_RETENTION_DAYS=90         # 告警保留天数
LG_DATABASE_WAL_MODE=true             # WAL 并发模式

# ── 日志补充（log，前缀 LG_LOG_）──────────────────────────
# LG_LOG_LOG_DIR=                     # 默认 backend/logs
LG_LOG_MAX_BYTES=10485760             # 单文件 10MB
LG_LOG_BACKUP_COUNT=5                 # 轮转保留份数
LG_LOG_CONSOLE=true                   # 控制台同步输出

# 说明：以上未列出的配置项同样可用 LG_<SECTION>_<KEY> 覆盖
# （SECTION/KEY 对应 backend/config/settings.py 各 dataclass 的节名与字段名，
# 如 LG_ROI_MAX_ROIS_PER_FRAME、LG_MOTION_DIFF_THRESHOLD 等）；
# 若变量写错节名或字段名，启动日志会出现"未命中任何配置字段"告警。
